<Window x:Class="AssemblyTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssemblyTranslator"
        mc:Ignorable="d"
        Title="Assembly translator - Tomáš Lojda" 
        Height="700" Width="1200" 
        Background="#FF20448A" FontFamily="Microsoft Sans Serif" FontSize="18" FontWeight="Bold" 
        Icon="/TranslatorLogo.png" Loaded="Window_Loaded">
    <Grid>
        <TextBox x:Name="InputTextBox" HorizontalAlignment="Left" Margin="50,50,0,0" Text="TextBox" VerticalAlignment="Top" Width="315" AcceptsTab="True" VerticalScrollBarVisibility="Visible" Height="562" AcceptsReturn="True"/>
        <Button Content="----&gt;" HorizontalAlignment="Center" Margin="0,265,0,0" VerticalAlignment="Top" Height="100" Width="240" FontSize="48" Click="Button_Click"/>
        <TextBox x:Name="OutputTextBox" HorizontalAlignment="Right" Margin="0,50,50,0" Text="TextBox" VerticalAlignment="Top" Width="315" AcceptsTab="True" VerticalScrollBarVisibility="Visible" Height="562"/>
    </Grid>
</Window>
